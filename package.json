{
  "name": "bohvue",
  "private": true,
  "version": "5.0.0",
  "sideEffects": [
    "*.css",
    "*.vue",
    "*.global.css",
    "src/main.js"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:views && npm run check:structure && npm run type-check && vite build",
    "build:full": "npm run build && npm run compress-images",
    "compress-images": "node scripts/compress-images.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:views": "node scripts/check-view-collisions.mjs",
    "check:structure": "node scripts/check-project-structure.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:bundle": "bash scripts/check-bundle-size.sh",
    "import:boh-kb": "node scripts/import-boh-knowledge-base.mjs",
    "build:ci": "npm run check:views && npm run check:structure && npm run type-check && vite build && bash scripts/check-bundle-size.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "altcha": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.7.1",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "lucide-vue-next": "^0.575.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pptxgenjs": "^4.0.1",
    "vue": "^3.5.24",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "cssnano": "^8.0.2",
    "esbuild": "^0.25.2",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.3.1",
    "terser": "^5.44.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
