{
  "name": "bohvue",
  "private": true,
  "version": "6.4.1",
  "engines": {
    "node": ">=22 <23"
  },
  "sideEffects": [
    "*.css",
    "*.vue",
    "*.global.css",
    "src/main.js"
  ],
  "type": "module",
  "scripts": {
    "prepare": "sh scripts/install-git-hooks.sh",
    "dev": "vite",
    "build": "npm run check:views && npm run check:structure && npm run type-check && npm run compress-images && vite build",
    "build:full": "npm run build",
    "compress-images": "node scripts/compress-images.mjs",
    "seed:boh-entities": "node scripts/seed-boh-entities.mjs",
    "seed:boh-entities:sql": "node scripts/build-boh-entity-seed-sql.mjs",
    "preview": "vite preview",
    "env:doctor": "node scripts/env-doctor.mjs",
    "env:doctor:strict": "node scripts/env-doctor.mjs --strict",
    "session:start": "npm run env:doctor && npm run verify:fast",
    "prepush": "node scripts/prepush.mjs",
    "ci:watch": "gh run watch $(gh run list -L 1 --json databaseId -q '.[0].databaseId') --exit-status",
    "gate:plan": "node scripts/gate-plan.mjs",
    "clean:screenshots": "node scripts/clean-screenshots.mjs",
    "lint": "eslint . --max-warnings 90",
    "lint:delta": "node scripts/lint-delta.mjs",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:views": "node scripts/check-view-collisions.mjs",
    "check:root-clean": "node scripts/check-root-clean.mjs",
    "check:root-clean:update": "node scripts/check-root-clean.mjs --update",
    "check:shell-grep": "node scripts/check-shell-grep.mjs",
    "check:doc-truth": "node scripts/check-doc-truth.mjs",
    "check:doc-truth:update": "node scripts/check-doc-truth.mjs --update",
    "check:structure": "node scripts/check-project-structure.mjs",
    "check:auth-validation": "node scripts/check-auth-validation-parity.mjs",
    "check:liquid-glass": "node scripts/check-liquid-glass.mjs",
    "check:important-budget": "node scripts/check-important-budget.mjs",
    "check:dark-tokens": "node scripts/check-dark-tokens.mjs",
    "check:dark-tokens:strict": "node scripts/check-dark-tokens.mjs --strict",
    "check:dark-tokens:update": "node scripts/check-dark-tokens.mjs --update",
    "check:gates-self-test": "node scripts/check-gates-self-test.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:layering:update": "node scripts/check-layering.mjs --update",
    "check:layering:list": "node scripts/check-layering.mjs --list",
    "check:untracked-imports": "node scripts/check-untracked-imports.mjs",
    "check:ratchets": "node scripts/check-ratchet-summary.mjs",
    "check:db-lint": "node scripts/check-db-lint.mjs",
    "check:db-advisors": "node scripts/check-db-advisors.mjs",
    "check:db-advisors:update": "node scripts/check-db-advisors.mjs --update",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:css:duplication": "node scripts/audit-css.mjs --duplication",
    "audit:css:orphans": "node scripts/audit-css.mjs --orphans",
    "check:first-paint": "node scripts/check-first-paint.mjs",
    "check:async-component-fallback": "node scripts/check-async-component-fallback.mjs",
    "check:async-component-fallback:update": "node scripts/check-async-component-fallback.mjs --update",
    "check:bohai-params": "node scripts/check-bohai-generation-params.mjs",
    "check:shell-precache": "node scripts/check-shell-precache.mjs",
    "check:route-css-runtime": "node scripts/check-route-css-runtime-cache.mjs",
    "check:sw-upgrade": "node scripts/check-sw-upgrade-precache-gc.mjs",
    "probe:ai-panels": "node scripts/probes/probe-ai-panels.mjs",
    "ai:config": "node scripts/probes/probe-ai-billing-config.mjs",
    "probe:route-switch": "node scripts/probes/probe-route-switch.mjs",
    "probe:cafe-layout": "node scripts/probes/probe-cafe-layout.mjs",
    "probe:cafe-mechanics": "node scripts/probes/probe-cafe-mechanics.mjs",
    "probe:a11y": "node scripts/probes/probe-a11y.mjs",
    "probe:dark-surfaces": "node scripts/probes/probe-dark-surfaces.mjs",
    "probe:a11y:update": "node scripts/probes/probe-a11y.mjs --update",
    "probe:a11y:report": "node scripts/probes/probe-a11y.mjs --report",
    "probe:dm-errors": "node scripts/probes/probe-datamanagement-errors.mjs",
    "audit:dm-columns": "node scripts/probes/audit-datamanagement-columns.mjs",
    "audit:dm-columns:live": "node --env-file=.env scripts/probes/verify-datamanagement-columns-live.mjs",
    "audit:dm-writable": "node scripts/probes/verify-datamanagement-writable-fields.mjs",
    "audit:dm-schema-refresh": "python3 scripts/probes/fetch-db-schema.py",
    "audit:dm": "npm run audit:dm-columns; npm run audit:dm-columns:live; npm run audit:dm-writable",
    "probe:userspace-switch": "node scripts/probes/probe-userspace-switch.mjs",
    "probe:userspace-pages": "node scripts/probes/probe-userspace-pages.mjs",
    "probe:css-failure": "node scripts/probes/probe-css-load-failure.mjs",
    "probe:css-visual": "node scripts/probes/probe-css-visual-check.mjs",
    "probe:passkey": "node scripts/probes/probe-passkey-login.mjs",
    "probe:composer-session-gate": "node scripts/probes/probe-composer-session-gate.mjs",
    "test": "vitest run",
    "verify": "npm run check:views && npm run check:structure && npm run check:auth-validation && npm run check:liquid-glass && npm run check:important-budget && npm run check:layering && npm run check:dark-tokens:strict && npm run check:first-paint && npm run check:async-component-fallback && npm run check:bohai-params && npm run check:root-clean && npm run check:untracked-imports && npm run check:shell-grep && npm run check:doc-truth && npm run lint && npm run type-check && npm run test && npm run check:ratchets",
    "verify:fast": "npm run check:views && npm run check:structure && npm run check:first-paint && npm run check:root-clean && npm run check:untracked-imports && npm run check:shell-grep && npm run check:doc-truth",
    "verify:full": "npm run verify && npm run build:ci",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "island:smoke": "node scripts/island-smoke.mjs",
    "test:watch": "vitest",
    "check:bundle": "bash scripts/check-bundle-size.sh",
    "import:boh-kb": "node scripts/import-boh-knowledge-base.mjs",
    "security:headers": "node scripts/cloudflare-security-headers.mjs",
    "security:headers:dry": "node scripts/cloudflare-security-headers.mjs --dry-run",
    "security:anon-check": "node scripts/check-anon-execute.mjs",
    "security:audit": "node scripts/check-npm-audit.mjs",
    "security:audit:update": "node scripts/check-npm-audit.mjs --update",
    "security:anon-check:update": "node scripts/check-anon-execute.mjs --update",
    "build:ci": "npm run check:views && npm run check:structure && npm run check:auth-validation && npm run security:anon-check && npm run type-check && npm run check:liquid-glass && npm run check:important-budget && npm run check:layering && npm run check:dark-tokens:strict && npm run check:first-paint && npm run check:async-component-fallback && npm run compress-images && vite build && npm run check:shell-precache && bash scripts/check-bundle-size.sh",
    "security:setup": "node scripts/cloudflare-setup.mjs",
    "security:setup:no-secret": "node scripts/cloudflare-setup.mjs --no-secret",
    "audit:coupling": "node scripts/audit-coupling.mjs",
    "compare:builds": "node scripts/compare-builds.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/motion": "^3.0.3",
    "@wxperia/liquid-glass-vue": "^1.0.9",
    "altcha": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "docx": "^9.7.1",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.575.0",
    "mammoth": "^1.12.0",
    "marked": "^17.0.2",
    "nsfwjs": "^4.3.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pptxgenjs": "^4.0.1",
    "vue": "^3.5.24",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.6.4"
  },
  "overrides": {
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "acorn": "^8.19.0",
    "cssnano": "^8.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.4.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.1",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
