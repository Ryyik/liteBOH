{
  "name": "bohvue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:views && npm run check:structure && npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:views": "node scripts/check-view-collisions.mjs",
    "check:structure": "node scripts/check-project-structure.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "bash scripts/check-bundle-size.sh",
    "import:boh-kb": "node scripts/import-boh-knowledge-base.mjs",
    "build:ci": "npm run check:views && npm run check:structure && npm run type-check && vite build && bash scripts/check-bundle-size.sh"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@supabase/supabase-js": "^2.99.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/motion": "^3.0.3",
    "altcha": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "lucide-vue-next": "^0.575.0",
    "marked": "^17.0.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.24",
    "vue-advanced-cropper": "^2.8.9",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "terser": "^5.44.1",
    "typescript": "^6.0.2",
    "vite": "^7.2.4",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.2.6"
  }
}
