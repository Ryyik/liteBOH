{
  "note": "机器可读的「改动 → 额外要跑什么」映射。人读版（含事故级坑记录）在 AGENTS.md §2 与 docs/gate-matrix.md；改门禁时两边都要改。verify 本身永远兜底，这里只列『额外』。",
  "entries": [
    {
      "glob": ".github/workflows/**",
      "run": ["npm run build:ci"],
      "why": "CI/部署链路改动必须过构建门禁"
    },
    {
      "glob": "src/App.vue",
      "run": ["npm run probe:route-switch"],
      "why": "路由组件 key / <RouterView> 切换"
    },
    {
      "glob": "src/views/Home/**",
      "run": [
        "node scripts/probes/probe-home-gate-pull.mjs",
        "node scripts/probes/probe-home-forum-rail.mjs",
        "node scripts/probes/probe-overview-island-guards.mjs"
      ],
      "why": "首屏拉动/落定动效 + 底栏布局 + 概览岛触发点（唯一触发点在首页 gateSettled）"
    },
    {
      "glob": "src/views/SmartOverview/**",
      "run": ["node scripts/probes/probe-overview-island-guards.mjs"],
      "why": "/overview 页口径（离线天数/去重标记）"
    },
    {
      "glob": "src/components/UnifiedNavbar/**",
      "run": [
        "node scripts/probes/probe-global-search.mjs",
        "node scripts/probes/probe-nav-mobile-menu.mjs"
      ],
      "why": "可见性/灵动岛/搜索 + 竖屏菜单几何"
    },
    {
      "glob": "src/utils/global-navbar-visibility.js",
      "run": ["node scripts/probes/probe-global-search.mjs"],
      "why": "可见性唯一真源"
    },
    {
      "glob": "src/views/user-center/UserSpace/**",
      "run": [
        "node scripts/probes/probe-rail-landing.mjs",
        "node scripts/probes/probe-rail-more-menu.mjs",
        "node scripts/probes/probe-composer-session-gate.mjs",
        "node scripts/probes/probe-user-space-ia.mjs",
        "node scripts/probes/probe-points-card-image.mjs"
      ],
      "why": "横屏左栏浮层/发布会话闸门/IA 结构/积分卡卡面"
    },
    {
      "glob": "src/views/user-center/Messages/**",
      "run": [
        "node scripts/probes/probe-messages-glass.mjs",
        "node scripts/probes/probe-messages-metrics.mjs"
      ],
      "why": "消息中心液态玻璃（采样链/像素级开-关/双主题）+ 顶部占位量测"
    },
    {
      "glob": "src/styles/themes/messages-dark.css",
      "run": ["node scripts/probes/probe-messages-glass.mjs"],
      "why": "消息暗色覆盖链：面板底色不许压死 token 玻璃（§21.11）"
    },
    {
      "glob": "src/views/Forum/**",
      "run": [
        "node scripts/probes/probe-composer-session-gate.mjs",
        "node scripts/probes/probe-composer-image-stall.mjs",
        "node scripts/probes/probe-forum-search.mjs",
        "node scripts/probes/probe-weekly-checkin-points.mjs"
      ],
      "why": "发布会话闸门（双宿主）+ 选图反馈口径 + 论坛搜索 RPC + 周签到"
    },
    {
      "glob": "src/views/PostDetail/**",
      "run": ["node scripts/probes/probe-reply-autogrow.mjs"],
      "why": "详情页评论框自动增高"
    },
    {
      "glob": "src/composables/useAutoGrowTextarea.js",
      "run": ["node scripts/probes/probe-reply-autogrow.mjs"],
      "why": "自动增高唯一真源（勿加第 5 份）"
    },
    {
      "glob": "src/views/BOHAI/**",
      "run": [
        "npm run probe:ai-panels",
        "node scripts/probes/probe-bohai-composer.mjs",
        "node scripts/probes/probe-bohai-shell.mjs",
        "node scripts/probes/probe-bohai-slash-commands.mjs",
        "node scripts/probes/probe-bohai-search-status.mjs",
        "node scripts/probes/probe-bohai-keepalive-stream.mjs",
        "node scripts/probes/probe-aichat-landscape-rail.mjs",
        "node scripts/probes/probe-bohai-portrait.mjs"
      ],
      "why": "AI 面板 + composer/壳/斜杠命令/推理块/切页不掐流/横屏左栏；事故记录见 docs/gate-matrix.md §C"
    },
    {
      "glob": "src/views/activities/**",
      "run": [
        "node scripts/probes/probe-activities-images.mjs",
        "node scripts/probes/probe-campaign-ui.mjs"
      ],
      "why": "活动页封面图（DB 图片列必须走 utils/db-image-url.js）+ 报名区/月份轨道"
    },
    {
      "glob": "src/views/ActivitiesWall/**",
      "run": ["node scripts/probes/probe-activities-images.mjs"],
      "why": "活动墙图片裂图同因"
    },
    {
      "glob": "src/views/user-center/Cloud+/**",
      "run": [
        "node scripts/probes/probe-cloud-album.mjs",
        "node scripts/probes/probe-cloud-portrait.mjs",
        "node scripts/probes/probe-cloud-motion.mjs"
      ],
      "why": "Cloud+ 图库形态/竖屏几何/动效（需 mock 数据，坑见 docs/gate-matrix.md）"
    },
    {
      "glob": "src/views/AvatarConsole/**",
      "run": [
        "node scripts/probes/probe-avatar-frame-grant.mjs",
        "node scripts/probes/probe-avatar-frame-console.mjs"
      ],
      "why": "头像框发放 + 控制台（新素材/变换）"
    },
    {
      "glob": "src/utils/subscription-benefits.js",
      "run": ["node scripts/probes/probe-subscription-benefits.mjs"],
      "why": "订阅权益 / 摄影集配额口径"
    },
    {
      "glob": "vite.config.js",
      "run": ["node scripts/probes/probe-vite-dep-scan.mjs"],
      "why": "依赖别名 / optimizeDeps；改图片管线或 SW 预缓存另跑 probe-perf-baseline（不进 verify 主链）"
    },
    {
      "glob": "src/styles/themes/**",
      "run": [],
      "note": "check:dark-tokens:strict 已在 verify 内（棘轮）"
    },
    { "glob": "src/utils/api/**", "run": [], "note": "check:layering 已在 verify 内（棘轮）" },
    {
      "glob": "supabase/migrations/**",
      "run": [],
      "note": "check:db-lint / check:db-advisors / probe-anon-revoke-safety（前两者需 Management API token，发布前跑，刻意不在 verify 内）"
    },
    {
      "glob": "supabase/functions/**",
      "run": ["npm run check:ef"],
      "why": "类型检查走 CI 的 deno-check.yml（阻断）；本地 `npm run check:ef` 预验。⚠️ esbuild 只删类型不查类型 —— 2026-10-29 实测漏过一个「调用点取失败分支专有字段」的联合类型错，只有 deno check 能拦"
    },
    {
      "glob": "scripts/lib/mail-keepalive-policy.mjs",
      "run": ["npm run mail:verify", "npm run mail:health"],
      "why": "邮件保活的阈值/告警口径唯一真源；改了必须回读云端（巡检是否在册、命令里的阈值是否同步）"
    },
    {
      "glob": "scripts/mail-keepalive-ops.mjs",
      "run": ["npm run mail:verify", "npm run mail:health"],
      "why": "保活运维脚本（需 Management API token，刻意不进 verify）"
    },
    {
      "glob": "package.json",
      "run": ["npm run check:gates-self-test"],
      "why": "改了 scripts/门禁清单就自证一遍"
    },
    {
      "glob": "scripts/lib/gate-fixtures.mjs",
      "run": ["npm run check:gates-self-test"],
      "why": "改了样本就全量自证"
    },
    {
      "glob": "src/views/Forum/components/CheckinRewardStage.vue",
      "run": ["node scripts/probes/probe-checkin-reward-stage.mjs"],
      "why": "签到 3D 舞台：旧弹窗下线 / 资源就绪先于起播 / 卡面真旋转 / 已签重播 / 横竖屏布局（改 ForumMain 签到链路同样要跑）"
    },
    {
      "glob": "src/utils/points-card-assets.js",
      "run": ["npx vitest run tests/unit/points-card-assets.test.js"],
      "why": "卡面资源收集与预取（decode/缓存/超时降级）的唯一真源"
    }
  ]
}
