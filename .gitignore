# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
# 探针对比用的第二份构建产物（probe-boot-perf.mjs 依赖，见 probe 脚本注释）
dist-check
dist-ssr
*.local
*.css.map

# 素材/文件的临时备份产物（曾误入库：mascot-new-*.webp.prevbak / .bak2）
*.bak
*.bak[0-9]
*.prevbak
*.orig
*.old
*.tmp
*~

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 用户配置文件（包含敏感信息）
src/config/users.config.js

# Environment and secrets
.env
.env.*
!.env.example
!.env.sample
# Supabase Edge Function 本地配置（含 ALTCHA_HMAC_KEY 等真实密钥，绝不可入库）
supabase/.env
supabase/functions/.env
*.pem
*.key
*.p12
*.pfx
auth.json
secrets*.json

# Android / TWA 打包（android-twa/ 只保留 twa-manifest.json 这一份真相源，
# 其余 Android 工程与签名文件都由 CI 的 bubblewrap update 现场生成，不入库）
android-twa/*
!android-twa/twa-manifest.json
*.keystore
*.jks
*.apk
*.aab

# Build reports
stats.html

# Supabase CLI 临时文件
supabase/.temp/

# 构建验证产物（构建站点快照，不应入库）
.build-verify*/
