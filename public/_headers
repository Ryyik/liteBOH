# 缓存策略 (适用于 Netlify / Cloudflare Pages 等支持 _headers 的平台)
# 当前部署目标 GitHub Pages 不支持自定义 HTTP 头，此文件为迁移到其他平台时备用。
# 生产环境实际缓存由 vite-plugin-pwa (Workbox Service Worker) 提供。

# 带 hash 的静态资源：长期缓存 (内容变更时 hash 自动更新)
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/static/images/*
  Cache-Control: public, max-age=31536000, immutable

/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 入口文件：每次验证新鲜度
/index.html
  Cache-Control: public, no-cache

# Service Worker：短缓存
/sw.js
  Cache-Control: public, max-age=0, must-revalidate