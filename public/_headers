# 缓存策略 (适用于 Netlify / Cloudflare Pages 等支持 _headers 的平台)
# 当前部署目标 GitHub Pages 不支持自定义 HTTP 头，此文件为迁移到其他平台时备用。
# 生产环境实际缓存由 vite-plugin-pwa (Workbox Service Worker) 提供。

# 带 hash 的静态资源：长期缓存 (内容变更时 hash 自动更新)
/static/js/*
  Cache-Control: public, max-age=31536000, immutable

/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/static/images/*
  Cache-Control: public, max-age=31536000, immutable

/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# HTML 入口文件：每次验证新鲜度
/index.html
  Cache-Control: public, no-cache

# Service Worker：短缓存
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker 的 importScripts 依赖：生成的 sw.js 里有一行 importScripts('/push-sw.js')，
# 它在 SW 安装时被浏览器**按普通请求**拉取，所以不受 updateViaCache:'none' 保护。
# 若这里或被 Cloudflare Cache Rules 缓存住，改了 push 处理器最多会延迟到缓存过期才生效
# （与 sw.js 那个 4 小时问题是同一类坑）。因此与 sw.js 同策略。
/push-sw.js
  Cache-Control: public, max-age=0, must-revalidate
